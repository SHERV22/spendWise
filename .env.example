# SpendWise - Environment Configuration Example
# Copy this file to .env or .env.local for local development.
# IMPORTANT: Never commit AWS secret access keys or passwords to frontend code!

# 1. AWS API Gateway Base URL (e.g. from SAM Output 'ApiEndpoint')
VITE_API_ENDPOINT=https://your-api-id.execute-api.ap-south-1.amazonaws.com/prod

# 2. Amazon Cognito User Pool ID (e.g. from SAM Output 'CognitoUserPoolId')
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx

# 3. Amazon Cognito App Client ID (e.g. from SAM Output 'CognitoClientId')
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. AWS Region where resources are deployed
VITE_AWS_REGION=ap-south-1
